# Copy to .env.local for local development. On Cloudflare, add these under Settings > Variables and Secrets.
# Full guide: docs/SELF_HOSTING.md. Generate APP_SECRET / CRON_SECRET / VAPID keys with: npm run secrets

# --- Required ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=          # secret: bypasses row-level security, server only
APP_SECRET=                    # 32+ random chars; encrypts users' stored keys and tokens
CRON_SECRET=                   # protects /api/cron
APP_URL=http://localhost:3000  # your deployed URL in production, no trailing slash

# --- Optional ---
SUPABASE_JWT_SECRET=           # legacy HS256 projects: checks tokens locally

# Gmail sending (each user connects their own mailbox in Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN=                  # set to 1 to show "Continue with Google" on the sign-in page

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=you@example.com

# Shared AI fallback. Leave unset on any instance with people you do not fully trust:
# users otherwise bring their own free Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
