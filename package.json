{
  "name": "outbox",
  "version": "0.1.0",
  "description": "Open-source job-search autopilot: drop any lead, get a personal email drafted in your voice, send it with one tap.",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "secrets": "node scripts/gen-secrets.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.45.4",
    "mammoth": "^1.8.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "wrangler": "4.151.2"
  }
}
